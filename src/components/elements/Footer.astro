---
import Container from "../shared/Container.astro";
import Social from "../shared/Social.astro";
import { profile } from "../../data/site";

const nav = [
  { href: "/#about", text: "About" },
  { href: "/#experience", text: "Experience" },
  { href: "/#projects", text: "Projects" },
  { href: "/#skills", text: "Skills" },
  { href: "/#beyond", text: "Beyond" },
  { href: "/#contact", text: "Contact" },
  { href: profile.resume, text: "Résumé" },
];
---

<footer class="relative border-t border-white/[0.07] pt-16 pb-10">
  <Container>
    <div class="grid gap-10 pb-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="font-display text-3xl text-white">{profile.name}</a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-zinc-500">
          Backend and agentic AI engineer in {profile.location}. Currently an MS CS student at NC
          State, open to Summer 2027 internships.
        </p>
        <Social className="mt-7" />
      </div>

      <div class="lg:col-span-4 lg:col-start-8">
        <h3 class="mb-5 font-mono text-[11px] uppercase tracking-[0.22em] text-zinc-600">
          Navigate
        </h3>
        <ul class="grid grid-cols-2 gap-y-3 text-sm">
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="link-underline text-zinc-400 transition-colors hover:text-white">
                  {n.text}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={`mailto:${profile.email}`}
          class="link-underline mt-7 inline-block font-mono text-[13px] text-zinc-400 transition-colors hover:text-white"
        >
          {profile.email}
        </a>
      </div>
    </div>

    <!-- oversized wordmark -->
    <div aria-hidden="true" class="select-none overflow-hidden border-t border-white/[0.07] pt-8">
      <p class="whitespace-nowrap text-center font-display text-[clamp(2.5rem,13vw,10rem)] leading-none tracking-tightest text-white/[0.045]">
        RITVIK PENDYALA
      </p>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 text-[12px] text-zinc-600 sm:flex-row">
      <p>© <span id="year">2026</span> {profile.name}. All rights reserved.</p>
      <p class="font-mono">Built with Astro + Tailwind</p>
    </div>
  </Container>
</footer>
