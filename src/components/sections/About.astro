---
import Container from "../shared/Container.astro";
import SectionHeading from "../shared/SectionHeading.astro";
import { education, profile } from "../../data/site";
---

<section id="about" class="relative scroll-mt-24 py-24 lg:py-32">
  <Container>
    <SectionHeading
      index="01"
      eyebrow="About"
      title="I build the <em class='font-display italic text-accent-soft'>systems</em> behind the systems."
      lede="Backend platforms, agent infrastructure, and the automation that keeps large test suites honest. Most of my work lives one layer below the interface — where correctness, state, and recovery actually get decided."
    />

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- portrait -->
      <div class="lg:col-span-5">
        <div data-reveal class="group relative overflow-hidden rounded-3xl border border-white/[0.07]">
          <img
            src={profile.photo}
            alt={`${profile.name} standing on a summit at sunrise`}
            width="1200"
            height="1600"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 1024px) 460px, 100vw"
            class="aspect-[3/4] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
          />
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/20 to-transparent"
          >
          </div>
          <div class="absolute inset-x-0 bottom-0 p-6">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-400">
              {profile.location}
            </p>
            <p class="mt-1.5 font-display text-2xl text-white">Ritvik Pendyala</p>
          </div>
        </div>
      </div>

      <!-- prose -->
      <div class="lg:col-span-7">
        <div class="space-y-6 text-[17px] leading-relaxed text-zinc-400">
          <p>
            For two years at <span class="text-zinc-200">HCL Software</span> I worked on DevOps Test,
            where I architected <span class="text-zinc-200">Vulcan</span> — an MCP-based browser
            automation engine that turns a live URL and a sentence of testing intent into
            regression-ready end-to-end tests. Alongside it I led
            <span class="text-zinc-200">Morpheus</span>, a Java/Spring platform that moved over a
            million legacy XML test assets onto a YAML-backed architecture with validation,
            rollback, and audit trails.
          </p>
          <p>
            The thread running through both: agents are only useful when they degrade well. Every
            AI-assisted path I shipped has a deterministic fallback behind it, because a test suite
            that silently repairs itself into the wrong assertion is worse than one that fails
            loudly.
          </p>
          <p>
            I'm now at <span class="text-zinc-200">NC State</span> for my Master's, building side
            projects that scratch my own itches — most recently
            <a href="/projects/soundboard" class="link-underline text-accent-soft">Soundboard</a>, a
            track-by-track rating graph for albums. I'm looking for a
            <span class="text-zinc-200">Summer 2027 software engineering internship</span> in
            backend, full-stack, or AI.
          </p>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={`mailto:${profile.email}`}
            class="group inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 font-mono text-[12.5px] text-zinc-400 transition-all duration-300 hover:border-accent/40 hover:text-white"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
              <rect x="1.5" y="3" width="13" height="10" rx="2" />
              <path d="m2 4.5 6 4 6-4" />
            </svg>
            {profile.email}
          </a>
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 font-mono text-[12.5px] text-zinc-400 transition-all duration-300 hover:border-accent/40 hover:text-white"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2v8M5 7l3 3 3-3M3 13h10" />
            </svg>
            Résumé
          </a>
        </div>

        <!-- education -->
        <h3 class="mb-5 mt-14 font-mono text-xs uppercase tracking-[0.22em] text-zinc-500">
          Education
        </h3>
        <div class="space-y-4">
          {
            education.map((e, i) => (
              <div
                data-reveal
                data-reveal-delay={i * 90}
                class="edge-card group rounded-2xl p-6 transition-transform duration-500 hover:-translate-y-1"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-4">
                    {e.logo && (
                      <img
                        src={e.logo}
                        alt=""
                        width="96"
                        height="96"
                        loading="lazy"
                        class="mt-0.5 h-10 w-10 shrink-0 rounded-lg object-contain"
                      />
                    )}
                    <div>
                      <h4 class="text-lg font-medium leading-snug text-white">{e.school}</h4>
                      <p class="mt-1 text-sm text-accent-soft">{e.degree}</p>
                    </div>
                  </div>
                  {e.current && (
                    <span class="shrink-0 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-emerald-300">
                      Current
                    </span>
                  )}
                </div>
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-zinc-500">
                  <span>{e.period}</span>
                  <span class="text-zinc-700">/</span>
                  <span>{e.place}</span>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-zinc-500">{e.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
