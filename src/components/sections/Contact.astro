---
import Container from "../shared/Container.astro";
import Social from "../shared/Social.astro";
import { profile } from "../../data/site";
---

<section id="contact" class="relative scroll-mt-24 py-24 lg:py-32">
  <Container>
    <div
      data-reveal
      class="edge-card relative overflow-hidden rounded-[2rem] px-7 py-14 sm:px-12 lg:px-16 lg:py-20"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-accent/20 blur-[100px]"></div>
        <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-cyan-500/15 blur-[100px]"></div>
      </div>

      <div class="relative grid gap-14 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono text-xs uppercase tracking-[0.22em] text-zinc-500">
            06 — Contact
          </span>
          <h2 class="mt-5 font-display text-4xl leading-[1.05] text-white sm:text-5xl">
            Let's build
            <span class="block bg-gradient-to-br from-accent-soft to-cyan-glow bg-clip-text text-transparent">
              something good.
            </span>
          </h2>
          <p class="mt-6 max-w-md leading-relaxed text-zinc-400">
            I'm looking for a Summer 2027 software engineering internship — backend, full-stack, or
            AI. If you're hiring, collaborating, or just want to argue about Formula 1 strategy,
            the inbox is open.
          </p>

          <div class="mt-9 space-y-3">
            <a
              href={`mailto:${profile.email}`}
              class="group flex items-center gap-3 text-zinc-300 transition-colors hover:text-white"
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-white/10 bg-white/[0.03] text-zinc-500 transition-colors group-hover:border-accent/40 group-hover:text-accent-soft">
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
                  <rect x="1.5" y="3" width="13" height="10" rx="2" />
                  <path d="m2 4.5 6 4 6-4" />
                </svg>
              </span>
              <span class="link-underline font-mono text-[13px]">{profile.email}</span>
            </a>
            <a
              href={`tel:${profile.phone.replace(/[^\d+]/g, "")}`}
              class="group flex items-center gap-3 text-zinc-300 transition-colors hover:text-white"
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-white/10 bg-white/[0.03] text-zinc-500 transition-colors group-hover:border-accent/40 group-hover:text-accent-soft">
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M3 2.5h3l1 3-1.6 1.2a9 9 0 0 0 4 4L10.5 9.5l3 1v3A11 11 0 0 1 3 2.5Z" />
                </svg>
              </span>
              <span class="link-underline font-mono text-[13px]">{profile.phone}</span>
            </a>
          </div>

          <Social className="mt-8" />
        </div>

        <!-- form -->
        <div class="lg:col-span-7">
          <form
            action="https://getform.io/f/e737301e-5629-48b4-a314-7101c28d68e7"
            method="POST"
            id="contact-form"
            class="space-y-5"
          >
            <input type="hidden" name="_gotcha" style="display:none !important" />

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-500">
                  Name
                </span>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-zinc-600 outline-none transition-all duration-300 focus:border-accent/60 focus:bg-white/[0.05] focus:ring-4 focus:ring-accent/10"
                />
              </label>

              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-500">
                  Email
                </span>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="w-full rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-white placeholder:text-zinc-600 outline-none transition-all duration-300 focus:border-accent/60 focus:bg-white/[0.05] focus:ring-4 focus:ring-accent/10"
                />
              </label>
            </div>

            <label class="block">
              <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.18em] text-zinc-500">
                Message
              </span>
              <textarea
                name="message"
                rows="6"
                required
                placeholder="What are you working on?"
                class="w-full resize-none rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm leading-relaxed text-white placeholder:text-zinc-600 outline-none transition-all duration-300 focus:border-accent/60 focus:bg-white/[0.05] focus:ring-4 focus:ring-accent/10"
              ></textarea>
            </label>

            <button
              type="submit"
              class="group inline-flex w-full items-center justify-center gap-2.5 rounded-xl bg-white px-7 py-3.5 text-sm font-medium text-ink-950 transition-transform duration-300 hover:scale-[1.01] sm:w-auto sm:px-10"
            >
              Send message
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </Container>
</section>
