---
import Container from "../shared/Container.astro";
import Social from "../shared/Social.astro";
import { profile, stats } from "../../data/site";
---

<section id="top" class="relative overflow-hidden pt-36 pb-24 sm:pt-44 lg:pt-52 lg:pb-32">
  <Container>
    <div class="grid items-end gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <!-- availability -->
        <div data-reveal class="mb-8 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] py-1.5 pl-2 pr-4 backdrop-blur-sm">
          <span class="relative grid h-5 w-5 place-items-center">
            <span class="absolute h-2 w-2 rounded-full bg-emerald-400 animate-pulse-ring"></span>
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-zinc-400">
            {profile.availability}
          </span>
        </div>

        <!-- name -->
        <h1 data-reveal data-reveal-delay="80" class="font-display text-[clamp(3rem,10vw,7.5rem)] leading-[0.92] tracking-tightest text-white">
          Ritvik
          <span class="block bg-gradient-to-br from-accent-soft via-white to-cyan-glow bg-clip-text text-transparent">
            Pendyala
          </span>
        </h1>

        <!-- rotating role -->
        <div data-reveal data-reveal-delay="160" class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-sm text-zinc-500">
          <span class="text-accent-soft">&gt;</span>
          <span id="role-rotator" class="text-zinc-200"></span>
          <span class="inline-block h-4 w-[2px] animate-pulse bg-accent-soft"></span>
        </div>

        <p data-reveal data-reveal-delay="220" class="mt-8 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
          {profile.tagline}
        </p>
        <p data-reveal data-reveal-delay="260" class="mt-4 max-w-2xl leading-relaxed text-zinc-500">
          {profile.summary}
        </p>

        <div data-reveal data-reveal-delay="320" class="mt-11 flex flex-wrap items-center gap-4">
          <a
            href="#projects"
            class="group relative inline-flex items-center gap-2.5 overflow-hidden rounded-full bg-white px-7 py-3.5 text-sm font-medium text-ink-950 transition-transform duration-300 hover:scale-[1.03]"
          >
            <span>View the work</span>
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3v10M4 9l4 4 4-4" />
            </svg>
          </a>
          <a
            href={profile.resume}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 rounded-full border border-white/12 px-7 py-3.5 text-sm font-medium text-zinc-200 transition-all duration-300 hover:border-accent/50 hover:bg-accent/10 hover:text-white"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2v8M5 7l3 3 3-3M3 13h10" />
            </svg>
            Résumé
          </a>
          <Social className="ml-1" />
        </div>
      </div>

      <!-- terminal card -->
      <div data-reveal data-reveal-delay="380" class="lg:col-span-4">
        <div class="edge-card animate-float rounded-2xl p-5 font-mono text-[12.5px] leading-relaxed">
          <div class="mb-4 flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-glow/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></span>
            <span class="ml-2 text-[11px] text-zinc-600">~/ritvik</span>
          </div>
          <div class="space-y-1.5 text-zinc-500">
            <p><span class="text-accent-soft">const</span> <span class="text-zinc-200">now</span> = {"{"}</p>
            <p class="pl-4">studying: <span class="text-emerald-300">"MS CS @ NC State"</span>,</p>
            <p class="pl-4">shipped: <span class="text-emerald-300">"MCP agents @ HCL"</span>,</p>
            <p class="pl-4">building: <span class="text-emerald-300">"Soundboard"</span>,</p>
            <p class="pl-4">based: <span class="text-emerald-300">"Raleigh, NC"</span>,</p>
            <p class="pl-4">seeking: <span class="text-emerald-300">"Summer 2027"</span>,</p>
            <p>{"}"};</p>
          </div>
        </div>
      </div>
    </div>

    <!-- stats strip -->
    <div data-reveal data-reveal-delay="440" class="mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.05] sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="group bg-ink-950/80 px-6 py-7 transition-colors duration-300 hover:bg-ink-900">
            <div class="font-display text-4xl text-white transition-colors duration-300 group-hover:text-accent-soft">
              {s.value}
            </div>
            <div class="mt-2 text-[13px] leading-snug text-zinc-500">{s.label}</div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<script>
  const roles = ["Backend Engineer", "Agentic AI Engineer", "MS CS @ NC State", "FIDE Master"];
  const el = document.getElementById("role-rotator");

  if (el && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let roleIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      const word = roles[roleIndex];
      charIndex += deleting ? -1 : 1;
      el.textContent = word.slice(0, charIndex);

      let delay = deleting ? 38 : 72;
      if (!deleting && charIndex === word.length) {
        delay = 1900;
        deleting = true;
      } else if (deleting && charIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        delay = 320;
      }
      window.setTimeout(tick, delay);
    };
    tick();
  } else if (el) {
    el.textContent = roles[0];
  }
</script>
