---
import Container from "../shared/Container.astro";
import SectionHeading from "../shared/SectionHeading.astro";
import ProjectCover from "../shared/ProjectCover.astro";
import { projects } from "../../data/site";

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
// derived so a filter can never render an empty grid
const categories = ["All", ...Array.from(new Set(rest.map((p) => p.category)))];
---

<section id="projects" class="relative scroll-mt-24 py-24 lg:py-32">
  <Container>
    <SectionHeading
      index="03"
      eyebrow="Projects"
      title="Things I've <em class='font-display italic text-accent-soft'>built</em>."
      lede="Full-stack products, machine learning research, and a few systems experiments. Every one has its own page — open it for the full write-up."
    />

    <!-- featured -->
    <div class="grid gap-6 lg:grid-cols-3">
      {
        featured.map((p, i) => (
          <a
            href={`/projects/${p.slug}`}
            data-reveal
            data-reveal-delay={i * 90}
            class="edge-card group relative flex flex-col overflow-hidden rounded-3xl transition-transform duration-500 hover:-translate-y-1.5"
          >
            <ProjectCover project={p} className="aspect-[7/5]" sizes="(min-width: 1024px) 380px, 100vw" />

            <div class="flex flex-1 flex-col p-7">
              <div class="flex items-center justify-between gap-4">
                <span class={`h-1.5 w-12 rounded-full bg-gradient-to-r ${p.accent}`} />
                <span class="font-mono text-[10.5px] uppercase tracking-wider text-zinc-600">
                  {p.period}
                </span>
              </div>

              <h3 class="mt-5 font-display text-3xl leading-tight text-white">{p.name}</h3>

              <p class="mt-3.5 flex-1 text-[14.5px] leading-relaxed text-zinc-400">{p.blurb}</p>

              <div class="mt-6 flex flex-wrap gap-1.5">
                {p.tags.slice(0, 5).map((t) => (
                  <span class="rounded-md border border-white/[0.07] bg-white/[0.03] px-2 py-1 font-mono text-[10.5px] text-zinc-500">
                    {t}
                  </span>
                ))}
              </div>

              <div class="mt-6 flex items-center gap-1.5 border-t border-white/[0.07] pt-5 text-[13px] text-zinc-300 transition-colors group-hover:text-white">
                <span class="link-underline">Read the case study</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- filters -->
    <div data-reveal class="mb-6 mt-16 flex flex-wrap items-center gap-2">
      <span class="mr-2 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-600">
        Archive
      </span>
      {
        categories.map((c) => (
          <button
            data-filter={c}
            data-active={c === "All" ? "true" : "false"}
            class="rounded-full border border-white/10 px-4 py-1.5 font-mono text-[11.5px] text-zinc-500 transition-all duration-300 hover:border-accent/40 hover:text-zinc-200 data-[active=true]:border-accent/60 data-[active=true]:bg-accent/15 data-[active=true]:text-white"
          >
            {c}
          </button>
        ))
      }
    </div>

    <!-- archive grid -->
    <div id="project-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((p, i) => (
          <a
            href={`/projects/${p.slug}`}
            data-project
            data-category={p.category}
            data-reveal
            data-reveal-delay={i * 50}
            class="edge-card group flex flex-col overflow-hidden rounded-2xl transition-all duration-500 hover:-translate-y-1"
          >
            <ProjectCover project={p} className="aspect-[7/5]" sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw" />

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-medium leading-snug tracking-tight text-white">
                  {p.name}
                </h3>
                <span class="mt-1 shrink-0 font-mono text-[10px] uppercase tracking-wider text-zinc-600">
                  {p.year}
                </span>
              </div>

              <p class="mt-3 flex-1 text-[13.5px] leading-relaxed text-zinc-500">{p.blurb}</p>

              <div class="mt-5 flex flex-wrap gap-1.5">
                {p.tags.slice(0, 3).map((t) => (
                  <span class="rounded-md border border-white/[0.07] bg-white/[0.03] px-2 py-0.5 font-mono text-[10px] text-zinc-500">
                    {t}
                  </span>
                ))}
              </div>

              <div class="mt-5 flex items-center justify-between gap-3 border-t border-white/[0.07] pt-4">
                <span class="inline-flex items-center gap-1.5 text-[12.5px] text-zinc-400 transition-colors group-hover:text-white">
                  <span class="link-underline">Details</span>
                  <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
                {p.advisor && (
                  <span class="truncate font-mono text-[10.5px] text-zinc-600">
                    {p.advisor.name}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-project]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => (b.dataset.active = b === btn ? "true" : "false"));

      cards.forEach((card) => {
        const match = filter === "All" || card.dataset.category === filter;
        card.style.display = match ? "" : "none";
        if (match) {
          card.style.opacity = "0";
          card.style.transform = "translateY(12px)";
          requestAnimationFrame(() => {
            card.style.opacity = "1";
            card.style.transform = "";
          });
        }
      });
    });
  });
</script>
