---
import type { Project } from "../../data/site";

export interface Props {
  project: Project;
  className?: string;
  eager?: boolean;
  sizes?: string;
}

const { project, className = "", eager = false, sizes } = Astro.props;
---

<div class={`relative overflow-hidden bg-ink-900 [container-type:size] ${className}`}>
  {
    project.cover ? (
      <img
        src={project.cover}
        alt={`${project.name} cover`}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        sizes={sizes}
        class="h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105"
      />
    ) : (
      <div class="relative h-full w-full">
        <div class={`absolute inset-0 bg-gradient-to-br ${project.accent} opacity-25`} />
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.14),transparent_60%)]" />
        <div class="cover-grid absolute inset-0" />
        <div class="absolute inset-0 grid place-items-center">
          <span class="font-display text-[22cqw] leading-none text-white/20">
            {project.name.charAt(0)}
          </span>
        </div>
      </div>
    )
  }
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent"
  >
  </div>
</div>

<style>
  .cover-grid {
    background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
  }
</style>
